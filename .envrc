# Ward dev environment (direnv). Entering the directory puts the mise-pinned
# toolchain (mise.toml) on PATH — no global shell activation needed. Optional
# sugar: everything also works via `mise run …` / `mise exec` without direnv,
# and CI uses mise directly. Run `direnv allow` once to enable.
watch_file mise.toml
if has mise; then
  # direnv evaluates .envrc with bash regardless of the user's shell
  eval "$(mise env -s bash)"
else
  log_error "mise not found — install it (https://mise.jdx.dev), then 'direnv reload'"
fi
