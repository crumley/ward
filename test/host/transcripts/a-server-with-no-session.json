{
  "scenario": "a-server-with-no-session",
  "recordedWith": "tmux 3.8",
  "steps": [
    {
      "kind": "run",
      "argv": [
        "start-server",
        ";",
        "set-option",
        "-s",
        "exit-empty",
        "off"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "list-sessions",
        "-F",
        "#{session_name}\t#{@ward_workspace}\t#{@ward_floor}\t#{@ward_view}\t#{session_created}\t#{session_attached}\t#{@ward_version}\t#{session_windows}\t#{session_group}"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "new-session",
        "-d",
        "-s",
        "main-f0-workspace",
        "-x",
        "120",
        "-y",
        "40",
        "-P",
        "-F",
        "#{window_id}",
        "cat",
        ";",
        "set-option",
        "-t",
        "=main-f0-workspace:",
        "@ward_workspace",
        "ws-conformance",
        ";",
        "set-option",
        "-t",
        "=main-f0-workspace:",
        "@ward_floor",
        "0",
        ";",
        "set-option",
        "-t",
        "=main-f0-workspace:",
        "@ward_version",
        "0.1.0",
        ";",
        "set-option",
        "-t",
        "=main-f0-workspace:",
        "detach-on-destroy",
        "off",
        ";",
        "set-option",
        "-t",
        "=main-f0-workspace:",
        "set-titles",
        "on",
        ";",
        "set-option",
        "-t",
        "=main-f0-workspace:",
        "set-titles-string",
        "#{window_name} · main f0#{?#{||:#{==:#{pane_title},},#{||:#{==:#{pane_title},#{host}},#{==:#{pane_title},#{host_short}}}},, · #{pane_title}}"
      ],
      "exit": 0,
      "stdout": "@1\n",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "new-window",
        "-d",
        "-a",
        "-P",
        "-F",
        "#{window_id}\t#{pane_id}",
        "-t",
        "=main-f0-workspace:{end}",
        "-n",
        "only",
        "cat"
      ],
      "exit": 0,
      "stdout": "@2\t%1\n",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "set-option",
        "-w",
        "-t",
        "@2",
        "@ward_session",
        "only",
        ";",
        "set-option",
        "-w",
        "-t",
        "@2",
        "@ward_epoch",
        "2026-11-18T00:00:30.000Z",
        ";",
        "set-option",
        "-w",
        "-t",
        "@2",
        "@ward_pane",
        "%1",
        ";",
        "set-option",
        "-w",
        "-t",
        "@2",
        "remain-on-exit",
        "failed",
        ";",
        "set-option",
        "-w",
        "-t",
        "@2",
        "automatic-rename",
        "off",
        ";",
        "set-option",
        "-w",
        "-t",
        "@2",
        "allow-rename",
        "off",
        ";",
        "respawn-pane",
        "-k",
        "-t",
        "%1",
        "-c",
        "<scratch>",
        "-e",
        "WARD_AGENT=only",
        "sleep",
        "600"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "kill-window",
        "-t",
        "@1"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "kind": "outside",
      "argv": [
        "kill-window",
        "-t",
        "@2"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "kind": "outside",
      "argv": [
        "list-sessions"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "list-panes",
        "-a",
        "-F",
        "#{session_name}\t#{window_id}\t#{pane_id}\t#{pane_dead}\t#{pane_dead_status}\t#{pane_dead_signal}\t#{@ward_session}\t#{@ward_epoch}\t#{@ward_pane}\t#{@ward_workspace}\t#{@ward_floor}\t#{window_index}"
      ],
      "exit": 1,
      "stdout": "",
      "stderr": "no current target\n"
    },
    {
      "kind": "run",
      "argv": [
        "list-sessions",
        "-F",
        "#{session_name}\t#{@ward_workspace}\t#{@ward_floor}\t#{@ward_view}\t#{session_created}\t#{session_attached}\t#{@ward_version}\t#{session_windows}\t#{session_group}"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "list-panes",
        "-a",
        "-F",
        "#{session_name}\t#{window_id}\t#{pane_id}\t#{pane_dead}\t#{pane_dead_status}\t#{pane_dead_signal}\t#{@ward_session}\t#{@ward_epoch}\t#{@ward_pane}\t#{@ward_workspace}\t#{@ward_floor}\t#{window_index}"
      ],
      "exit": 1,
      "stdout": "",
      "stderr": "no current target\n"
    },
    {
      "kind": "run",
      "argv": [
        "show-environment",
        "-g"
      ],
      "exit": 0,
      "stdout": "HOME=<scratch>\nLANG=en_US.UTF-8\nPATH=/usr/bin:/bin\nPWD=<scratch>\nSHELL=/bin/sh\n",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "list-sessions",
        "-F",
        "#{session_name}\t#{@ward_workspace}\t#{@ward_floor}\t#{@ward_view}\t#{session_created}\t#{session_attached}\t#{@ward_version}\t#{session_windows}\t#{session_group}"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "new-session",
        "-d",
        "-s",
        "main-f0-workspace",
        "-x",
        "120",
        "-y",
        "40",
        "-P",
        "-F",
        "#{window_id}",
        "cat",
        ";",
        "set-option",
        "-t",
        "=main-f0-workspace:",
        "@ward_workspace",
        "ws-conformance",
        ";",
        "set-option",
        "-t",
        "=main-f0-workspace:",
        "@ward_floor",
        "0",
        ";",
        "set-option",
        "-t",
        "=main-f0-workspace:",
        "@ward_version",
        "0.1.0",
        ";",
        "set-option",
        "-t",
        "=main-f0-workspace:",
        "detach-on-destroy",
        "off",
        ";",
        "set-option",
        "-t",
        "=main-f0-workspace:",
        "set-titles",
        "on",
        ";",
        "set-option",
        "-t",
        "=main-f0-workspace:",
        "set-titles-string",
        "#{window_name} · main f0#{?#{||:#{==:#{pane_title},},#{||:#{==:#{pane_title},#{host}},#{==:#{pane_title},#{host_short}}}},, · #{pane_title}}"
      ],
      "exit": 0,
      "stdout": "@3\n",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "new-window",
        "-d",
        "-a",
        "-P",
        "-F",
        "#{window_id}\t#{pane_id}",
        "-t",
        "=main-f0-workspace:{end}",
        "-n",
        "again",
        "cat"
      ],
      "exit": 0,
      "stdout": "@4\t%2\n",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "set-option",
        "-w",
        "-t",
        "@4",
        "@ward_session",
        "again",
        ";",
        "set-option",
        "-w",
        "-t",
        "@4",
        "@ward_epoch",
        "2026-11-18T00:00:32.000Z",
        ";",
        "set-option",
        "-w",
        "-t",
        "@4",
        "@ward_pane",
        "%2",
        ";",
        "set-option",
        "-w",
        "-t",
        "@4",
        "remain-on-exit",
        "failed",
        ";",
        "set-option",
        "-w",
        "-t",
        "@4",
        "automatic-rename",
        "off",
        ";",
        "set-option",
        "-w",
        "-t",
        "@4",
        "allow-rename",
        "off",
        ";",
        "respawn-pane",
        "-k",
        "-t",
        "%2",
        "-c",
        "<scratch>",
        "-e",
        "WARD_AGENT=again",
        "sleep",
        "600"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "kill-window",
        "-t",
        "@3"
      ],
      "exit": 0,
