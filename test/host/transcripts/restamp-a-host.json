{
  "scenario": "restamp-a-host",
  "recordedWith": "tmux 3.8",
  "steps": [
    {
      "kind": "run",
      "argv": [
        "start-server",
        ";",
        "set-option",
        "-s",
        "exit-empty",
        "off"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "list-sessions",
        "-F",
        "#{session_name}\t#{@ward_workspace}\t#{@ward_floor}\t#{@ward_view}\t#{session_created}\t#{session_attached}\t#{@ward_version}\t#{session_windows}\t#{session_group}"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "new-session",
        "-d",
        "-s",
        "main-f1-alpha",
        "-x",
        "120",
        "-y",
        "40",
        "-P",
        "-F",
        "#{window_id}",
        "cat",
        ";",
        "set-option",
        "-t",
        "=main-f1-alpha:",
        "@ward_workspace",
        "ws-conformance",
        ";",
        "set-option",
        "-t",
        "=main-f1-alpha:",
        "@ward_floor",
        "1",
        ";",
        "set-option",
        "-t",
        "=main-f1-alpha:",
        "@ward_version",
        "0.1.0",
        ";",
        "set-option",
        "-t",
        "=main-f1-alpha:",
        "detach-on-destroy",
        "off",
        ";",
        "set-option",
        "-t",
        "=main-f1-alpha:",
        "set-titles",
        "on",
        ";",
        "set-option",
        "-t",
        "=main-f1-alpha:",
        "set-titles-string",
        "#{window_name} · main f1#{?#{||:#{==:#{pane_title},},#{||:#{==:#{pane_title},#{host}},#{==:#{pane_title},#{host_short}}}},, · #{pane_title}}"
      ],
      "exit": 0,
      "stdout": "@1\n",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "new-window",
        "-d",
        "-a",
        "-P",
        "-F",
        "#{window_id}\t#{pane_id}",
        "-t",
        "=main-f1-alpha:{end}",
        "-n",
        "alpha",
        "cat"
      ],
      "exit": 0,
      "stdout": "@2\t%1\n",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "set-option",
        "-w",
        "-t",
        "@2",
        "@ward_session",
        "alpha",
        ";",
        "set-option",
        "-w",
        "-t",
        "@2",
        "@ward_epoch",
        "2026-11-18T00:00:38.000Z",
        ";",
        "set-option",
        "-w",
        "-t",
        "@2",
        "@ward_pane",
        "%1",
        ";",
        "set-option",
        "-w",
        "-t",
        "@2",
        "remain-on-exit",
        "failed",
        ";",
        "set-option",
        "-w",
        "-t",
        "@2",
        "automatic-rename",
        "off",
        ";",
        "set-option",
        "-w",
        "-t",
        "@2",
        "allow-rename",
        "off",
        ";",
        "respawn-pane",
        "-k",
        "-t",
        "%1",
        "-c",
        "<scratch>",
        "-e",
        "WARD_AGENT=alpha",
        "sleep",
        "600"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "kill-window",
        "-t",
        "@1"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "set-option",
        "-t",
        "=main-f1-alpha:",
        "@ward_floor",
        "22"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "kind": "outside",
      "argv": [
        "show-options",
        "-v",
        "-t",
        "=main-f1-alpha:",
        "@ward_floor"
      ],
      "exit": 0,
      "stdout": "22\n",
      "stderr": ""
    },
    {
      "kind": "outside",
      "argv": [
        "show-options",
        "-v",
        "-t",
        "=main-f1-alpha:",
        "@ward_workspace"
      ],
      "exit": 0,
      "stdout": "ws-conformance\n",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "list-sessions",
        "-F",
        "#{session_name}\t#{@ward_workspace}\t#{@ward_floor}\t#{@ward_view}\t#{session_created}\t#{session_attached}\t#{@ward_version}\t#{session_windows}\t#{session_group}"
      ],
      "exit": 0,
      "stdout": "main-f1-alpha\tws-conformance\t22\t\t1\t0\t0.1.0\t1\t\n",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "new-window",
        "-d",
        "-a",
        "-P",
        "-F",
        "#{window_id}\t#{pane_id}",
        "-t",
        "=main-f1-alpha:{end}",
        "-n",
        "alpha-2",
        "cat"
      ],
      "exit": 0,
      "stdout": "@3\t%2\n",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "set-option",
        "-w",
        "-t",
        "@3",
        "@ward_session",
        "alpha-2",
        ";",
        "set-option",
        "-w",
        "-t",
        "@3",
        "@ward_epoch",
        "2026-11-18T00:00:13.000Z",
        ";",
        "set-option",
        "-w",
        "-t",
        "@3",
        "@ward_pane",
        "%2",
        ";",
        "set-option",
        "-w",
        "-t",
        "@3",
        "remain-on-exit",
        "failed",
        ";",
        "set-option",
        "-w",
        "-t",
        "@3",
        "automatic-rename",
        "off",
        ";",
        "set-option",
        "-w",
        "-t",
        "@3",
        "allow-rename",
        "off",
        ";",
        "respawn-pane",
        "-k",
        "-t",
        "%2",
        "-c",
        "<scratch>",
        "-e",
        "WARD_AGENT=alpha-2",
        "sleep",
        "600"
      ],
      "exit": 0,
      "stdout": "",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "list-panes",
        "-a",
        "-F",
        "#{session_name}\t#{window_id}\t#{pane_id}\t#{pane_dead}\t#{pane_dead_status}\t#{pane_dead_signal}\t#{@ward_session}\t#{@ward_epoch}\t#{@ward_pane}\t#{@ward_workspace}\t#{@ward_floor}\t#{window_index}"
      ],
      "exit": 0,
      "stdout": "main-f1-alpha\t@2\t%1\t0\t\t\talpha\t2026-11-18T00:00:38.000Z\t%1\tws-conformance\t22\t1\nmain-f1-alpha\t@3\t%2\t0\t\t\talpha-2\t2026-11-18T00:00:13.000Z\t%2\tws-conformance\t22\t2\n",
      "stderr": ""
    },
    {
      "kind": "run",
      "argv": [
        "set-option",
        "-t",
        "=main-f9-x:",
        "@ward_floor",
        "9"
      ],
      "exit": 1,
      "stdout": "",
      "stderr": "no such session: =main-f9-x:\n"
    },
    {
      "kind": "outside",
      "argv": [
        "list-sessions",
        "-F",
        "#{session_name}"
      ],
      "exit": 0,
      "stdout": "main-f1-alpha\n",
      "stderr": ""
    }
  ]
}
